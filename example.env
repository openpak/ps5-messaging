# HTTP listen address. Plain HTTP behind the reverse proxy (Traefik), which terminates TLS for
# m.np.playstation.com and forwards /api/gamingLoungeGroups/ here.
PS5_ADDR=:8080
# Required. HMAC key shared with ps5-auth, which issues the bearer tokens (at least 32 bytes).
PS5_TOKEN_KEY=
# PS5_LOG_LEVEL=info

# Postgres for player state (REQUIRED unless PS5_DEV_MEMORY=1). Pool is 3 connections. On openpak.network
# the host is the postgres container; create the role/database once:
#   CREATE ROLE ps5 LOGIN PASSWORD '...'; CREATE DATABASE ps5 OWNER ps5;
# friends and messaging share this one database (tables ps5_friends*, ps5_blocks, ps5_msg_*).
PS5_DATABASE_URL=postgres://ps5:change-me@openpak-postgres:5432/ps5?sslmode=disable
# Local development only: keep state in memory (lost on restart). The service refuses to start
# without its database or core otherwise.
# PS5_DEV_MEMORY=1
# Account erasure endpoint (DELETE /internal/accounts/{id}/data). Unset = not served.
# ACCOUNT_ERASE_KEY=change-me-shared-erase-key
# ERASE_ADDR=:9099
